# Build an npc image from a released binary.
#
# This is the counterpart to the Dockerfile.npc at the repository root. That
# one compiles from source and needs a Go toolchain and working DNS inside the
# build; this one takes the binary from a release you have already downloaded
# and verified, which is both faster and one less thing to fail on a node.
#
# Build context needs one file: an executable named npc.
#
#   ARCH=$(uname -m); case $ARCH in x86_64) A=amd64;; aarch64|arm64) A=arm64;; esac
#   curl -fsSLO https://github.com/hector918/nps/releases/latest/download/linux_${A}_client.tar.gz
#   curl -fsSLO https://github.com/hector918/nps/releases/latest/download/sha256sums.txt
#   sha256sum -c --ignore-missing sha256sums.txt          # do not skip this
#   tar -xzOf linux_${A}_client.tar.gz npc > npc          # the binary only
#   chmod +x npc
#   docker build -f Dockerfile.npc -t npc:v0.27.13-hz1 .
#
# Only npc comes out of the tarball on purpose. It also carries conf/npc.conf,
# which is a template -- baking that into an image, or unpacking it over a
# node, replaces the real vkey and tunnel list with placeholders.
#
# Knobs, in the order people usually need them:
#
#   --build-arg BASE=...    what to build on. The binary is static (built with
#                           CGO_ENABLED=0), so scratch works; alpine is the
#                           default because it brings a shell for docker exec
#                           and CA certificates, which the binary needs for
#                           anything it fetches over HTTPS.
#   the COPY destination    /usr/bin/npc here. Change it and change ENTRYPOINT
#                           to match -- ENTRYPOINT cannot read a build arg.
#   CMD                     the default config path. Override per container
#                           rather than editing this, e.g.
#                             docker run ... npc:tag -config=/etc/npc/npc.conf
#
ARG BASE=alpine:3.20
FROM ${BASE}

# Present so the binary can verify TLS. Harmless on a base that already has
# them; remove this line when building on scratch or distroless.
RUN apk add --no-cache ca-certificates 2>/dev/null || true

COPY npc /usr/bin/npc

ENTRYPOINT ["/usr/bin/npc"]
CMD ["-config=/conf/npc.conf"]
