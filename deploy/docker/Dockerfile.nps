# Build an nps (server) image from a released binary. See Dockerfile.npc in
# this directory for the reasoning; the server has two differences that bite.
#
#   ARCH=$(uname -m); case $ARCH in x86_64) A=amd64;; aarch64|arm64) A=arm64;; esac
#   curl -fsSLO https://github.com/hector918/nps/releases/latest/download/linux_${A}_server.tar.gz
#   curl -fsSLO https://github.com/hector918/nps/releases/latest/download/sha256sums.txt
#   sha256sum -c --ignore-missing sha256sums.txt
#   tar -xzf linux_${A}_server.tar.gz nps web            # binary AND web/
#   docker build -f Dockerfile.nps -t nps:v0.27.13-hz1 .
#
# First: the binary is not enough. The server reads its templates and static
# files from disk at runtime, so web/ ships with it. That is also why updating
# a server by swapping only its binary is wrong whenever a release touched
# those files.
#
# Second, and easy to get wrong: where the binary sits decides where it looks
# for everything else. common.GetRunPath returns /etc/nps when that directory
# exists and otherwise the directory holding the executable -- and web/views,
# web/static and conf/*.json are all resolved against it. Putting the binary
# in /usr/bin would send it looking for /usr/bin/web/views and render a blank
# panel. Hence / here, which makes the paths /web and /conf.
#
# Everything in conf/ -- nps.conf, clients.json, hosts.json, tasks.json, the
# certificate pair -- is state, not image content. Mount the real ones at
# /conf; baking the templates in hands every container a blank client list and
# a sample key that is published in the repository.
#
ARG BASE=alpine:3.20
FROM ${BASE}

# So the binary can verify TLS. Delete this line when building on scratch or
# distroless, which have no shell for RUN to use.
RUN apk add --no-cache ca-certificates 2>/dev/null || true

COPY nps /nps
COPY web /web

VOLUME /conf
ENTRYPOINT ["/nps"]
