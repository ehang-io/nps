# See Dockerfile.npc: the 1.15 pin no longer builds against current
# dependencies.
FROM golang:1.26 AS builder
ARG GOPROXY=https://proxy.golang.org,direct
ARG VERSION=dev
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-w -s -X ehang.io/nps/lib/version.VERSION=${VERSION}" \
    -o /out/nps ./cmd/nps/nps.go

FROM scratch
COPY --from=builder /out/nps /nps
# The server reads its templates and static files from disk at runtime, so
# they ship with the binary rather than inside it.
COPY --from=builder /src/web /web
VOLUME /conf
CMD ["/nps"]
